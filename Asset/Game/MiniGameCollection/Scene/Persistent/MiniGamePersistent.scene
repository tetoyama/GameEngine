            InputPins:
              - 8
              - 10
              - 11
            OutputPin: 9
            Param:
              x: 0
              y: 0
              z: 0
              w: 0
            ResolutionScale: 1
            MipLevels: 1
        PostEffectLinks:
          - ID: 4
            StartNode: 0
            EndNode: 2
            StartAttr: 2
            EndAttr: 10
          - ID: 5
            StartNode: -1
            EndNode: 1
            StartAttr: 5
            EndAttr: 3
          - ID: 6
            StartNode: 2
            EndNode: -2
            StartAttr: 9
            EndAttr: 6
          - ID: 9
            StartNode: -1
            EndNode: 2
            StartAttr: 5
            EndAttr: 8
          - ID: 10
            StartNode: 1
            EndNode: 0
            StartAttr: 4
            EndAttr: 1
        ScreenInput:
          Name: ""
          NodePos:
            x: 40
            y: 50
          OutputPin: 5
        ScreenOutput:
          Name: ""
          NodePos:
            x: 500
            y: 50
          InputPins:
            - 6
