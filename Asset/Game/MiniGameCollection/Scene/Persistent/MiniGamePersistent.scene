          x: 0
          y: 13.5
          z: -15.5
        Rotation:
          - 0
          - 0
          - 0
          - 1
        Scale:
          x: 1
          y: 1
          z: 1
        Parent: 0
      - Component: CameraComponent
        isLock: true
        Target:
          x: 0
          y: 0.35
          z: 0
        NearClip: 0.05
        FarClip: 256
        FOV: 0.8
        nextLinkId: 11
        nextPinId: 13
        PostEffects:
          - Name: MiniGameBlur
