SceneSettings:
  Storage:
    ExpectedEntities: 320
    ExpectedTransforms: 240
    ExpectedRenderables: 96
    ExpectedCullingComponents: 96
    ExpectedStaticEntities: 32
    PreallocatedTransformPages: 0
    PreallocatedTagPages: 0
    RenderPacketReserve: 192
    VisibleEntityReserve: 192
    StaticBatchReserve: 16
    AllowRuntimeGrowth: true
    LogCapacityGrowth: true
Entities:
  - Entity: 1
    Components:
      - Component: NameComponent
        Name: MiniGamePersistentRuntime
      - Component: MiniGameCollection::Runtime::MiniGamePersistentRuntime
        ScriptName: MiniGamePersistentRuntime
        SelectedIndex: 0
  - Entity: 2
    Components:
      - Component: NameComponent
        Name: MiniGameCamera
      - Component: TransformComponent
