Storage:
  ExpectedEntities: 256
  ExpectedTransformCount: 256
  TransformPreallocatedPages: 1
Entities:
  - Entity: 1
    Components:
      - Component: NameComponent
        Name: ElemenTactics Runtime Controller
      - Component: TransformComponent
        Position:
          x: 0
          y: 0
          z: 0
        Rotation:
          - 0
          - 0
          - 0
          - 1
        Scale:
          x: 1
          y: 1
          z: 1
        Parent: 0
      - Component: ElemenTactics::ElemenTacticsGameController
        ScriptName: ElemenTacticsGameController
        InitialScreen: Title
      - Component: ElemenTactics::ElemenTacticsKeyboardNavigator
        ScriptName: ElemenTacticsKeyboardNavigator
  - Entity: 2
    Components:
      - Component: NameComponent
        Name: ElemenTactics Player Camera
      - Component: TransformComponent
        Position:
          x: 0
          y: 0
          z: -10
        Rotation:
          - 0
          - 0
          - 0
          - 1
        Scale:
          x: 1
          y: 1
          z: 1
        Parent: 0
      - Component: CameraComponent
        isLock: true
        Target:
          x: 0
          y: 0
          z: 0
        NearClip: 0.01
        FarClip: 1024
        FOV: 1
