        tripleJumpMinimumSpeed: 4.19999981
        tripleJumpChainWindow: 0.319999993
        wallProbeDistance: 0.620000005
        wallContactGrace: 0.140000001
        wallKickHorizontalVelocity: 7.19999981
        wallKickVerticalVelocity: 8.80000019
