Entities:
  - LocalID: 0
    Components:
      - Component: NameComponent
        Name: PlatformerPlayerFeedback
      - Component: TransformComponent
        Position: {x: 0, y: 0, z: 0}
        Rotation: [0, 0, 0, 1]
        Scale: {x: 1, y: 1, z: 1}
        Parent: 0
      - Component: ParticleComponent
        IsLoop: false
        SpawnInterval: 0.04
        SpawnCount: 36
        SpawnTimer: 0
        ParticleLifeTime: 0.8
        ParticleSize: 0.14
        ParticleSpeed: 1
        SpawnPosition: {x: 0, y: 0, z: 0}
        SpawnPositionRandom: {x: 0, y: 0, z: 0}
        StartSpeed: {x: 0, y: 3, z: 0}
        StartSpeedRandom: {x: 1, y: 1, z: 1}
        AddSpeed: {x: 0, y: -9, z: 0}
        MulSpeed: {x: 0.95, y: 0.95, z: 0.95}
      - Component: AudioComponent
        FilePath: Asset\Audio\BGM.wav
        Loop: false
        Volume: 0.12
        PlayOnStart: false
      - Component: PlatformerPlayerFeedback
        particleVerticalOffset: 0.45
