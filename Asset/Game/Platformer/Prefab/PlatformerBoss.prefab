Entities:
  - LocalID: 0
    Components:
      - Component: NameComponent
        Name: PlatformerBoss
      - Component: TransformComponent
        Position: {x: 0, y: 0, z: 0}
        Rotation: [0, 0, 0, 1]
        Scale: {x: 2.4, y: 2.0, z: 2.4}
        Parent: 0
      - Component: ColliderComponent
        isDynamic: true
        autoMass: true
        Mass: 12
        colliders:
          - type: 0
            size: [1, 1, 1]
            offset: [0, 0.5, 0]
            rotationOffset: [0, 0, 0]
            radius: 0.5
            height: 1
            staticFriction: 0.15
            dynamicFriction: 0.08
            restitution: 0
            collisionLayer: 0
            lockRotX: true
            lockRotY: true
            lockRotZ: true
            isTrigger: false
            boneName: ""
      - Component: MaterialComponent
        ShaderID: 1
        Material:
          BaseColor: {x: 0.34, y: 0.08, z: 0.46, w: 1}
          Metallic: 0.3
          Roughness: 0.48
          AO: 1
          EmissiveColor: {x: 0.12, y: 0.01, z: 0.2}
          EmissiveIntensity: 0.75
          UseDiffuseTexture: true
          UseNormalTexture: true
          UseEnvironmentMap: true
      - Component: TextureComponent
        FilePath: Asset\Texture\white.tga
        UV_Slice_X: 1
        UV_Slice_Y: 1
        AnimationNum: 0
      - Component: ModelRendererComponent
        FilePath: Asset\Model\cube.obj
        isBlender: false
        AnimationTime: 0
      - Component: ParticleComponent
        IsLoop: false
        SpawnInterval: 0.04
        SpawnCount: 40
        SpawnTimer: 0
        ParticleLifeTime: 1
        ParticleSize: 0.22
        ParticleSpeed: 1
        SpawnPosition: {x: 0, y: 0, z: 0}
        SpawnPositionRandom: {x: 0, y: 0, z: 0}
        StartSpeed: {x: 0, y: 3, z: 0}
        StartSpeedRandom: {x: 2, y: 2, z: 2}
        AddSpeed: {x: 0, y: -8, z: 0}
        MulSpeed: {x: 0.95, y: 0.95, z: 0.95}
      - Component: AudioComponent
        FilePath: Asset\Audio\BGM.wav
        Loop: false
        Volume: 0.18
        PlayOnStart: false
      - Component: PlatformerBoss
        maxHealth: 3
        activationDistance: 13
        introDuration: 1.1
        chaseDuration: 2.2
        chaseSpeed: 2.8
        telegraphDuration: 0.9
        chargeSpeed: 10.5
        chargeDuration: 1.35
        chargeMaxDistance: 12
        stunDuration: 2.7
        recoverDuration: 0.65
        stompHeightMargin: 0.75
        defeatClearDelay: 1.8
