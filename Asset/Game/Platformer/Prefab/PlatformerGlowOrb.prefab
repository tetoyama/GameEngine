Entities:
  - LocalID: 0
    Components:
      - Component: NameComponent
        Name: PlatformerGlowOrb
      - Component: TransformComponent
        Position: {x: 0, y: 0, z: 0}
        Rotation: [0, 0, 0, 1]
        Scale: {x: 0.28, y: 0.28, z: 0.28}
        Parent: 0
      - Component: StaticEntityComponent
      - Component: CullingComponent
      - Component: MaterialComponent
        ShaderID: 1
        Material:
          BaseColor: {x: 1, y: 0.65, z: 0.25, w: 1}
          Metallic: 0.25
          Roughness: 0.2
          AO: 1
          EmissiveColor: {x: 1, y: 0.45, z: 0.12}
          EmissiveIntensity: 3.2
          UseDiffuseTexture: true
          UseNormalTexture: true
          UseEnvironmentMap: true
      - Component: TextureComponent
        FilePath: Asset\Texture\white.tga
        UV_Slice_X: 1
        UV_Slice_Y: 1
        AnimationNum: 0
      - Component: ModelRendererComponent
        FilePath: Asset\Model\ball.fbx
        isBlender: false
        AnimationTime: 0
