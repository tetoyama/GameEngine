#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Fill
{
    float4 color;
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(8u, 8u, 1u);

kernel void main0(constant Fill& fill [[buffer(0)]], texture2d<float, access::write> destination [[texture(0)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    int2 p = int2(gl_GlobalInvocationID.xy);
    if (all(p < int2(destination.get_width(), destination.get_height())))
    {
        destination.write(fill.color, uint2(p));
    }
}
