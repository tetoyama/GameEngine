<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Visual Studio / MSBuild は Windows 上では大文字小文字を区別せずに解決できるが、
    Git の実ファイル名と .vcxproj 上の Include 表記がずれていると、
    Solution 再読み込み・フィルタ表示・外部変更検知が不安定に見える場合がある。

    GameEngine.vcxproj 本体は巨大で手動マージ衝突が起きやすいため、
    評価後の Item をここで正規化する。

    Directory.Build.targets は配下の全 Project に自動Importされる。
    Script.vcxproj へEngine側のcppを混入させないよう、GameEngineだけに限定する。
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GameEngine'">
    <ClCompile Remove="Source\GameApplication\Engine\Editor\UI\hierarchy.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Editor\UI\inspector.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Editor\UI\menuBar.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Editor\UI\performanceMonitor.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Editor\UI\systemSetting.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Editor\UI\viewWindow.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Scene\System\Script\scriptSystem.cpp" />
    <ClCompile Remove="Source\GameApplication\Engine\Scene\System\Script\customScriptSystem.cpp" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GameEngine'">
    <ClCompile Include="Source\GameApplication\Engine\Editor\UI\Hierarchy.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Editor\UI\Inspector.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Editor\UI\MenuBar.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Editor\UI\PerformanceMonitor.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Editor\UI\SystemSetting.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Editor\UI\ViewWindow.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Resources\Loader\textureLoaderLink.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Scene\System\Script\ScriptSystem.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Scene\System\Script\CustomScriptSystem.cpp" />
    <ClCompile Include="Source\GameApplication\Engine\Scene\Script\GN31.cpp" />
  </ItemGroup>

  <!--
    Step 17-C / 17-D / 17-E / 17-F / Step 18-A / M-5で追加・削除したHeaderを
    評価後のProject Itemへ反映する。vcxproj本体を全体書き換えせず、
    Solution Explorerと外部変更検知を同期する。
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GameEngine'">
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Animation\RenderSystemAnimationTaskRegistration.h" />
    <ClInclude Remove="Source\GameApplication\Service\Graphics\D3D11ConstantBufferUpload.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Animation\RenderSystemAnimationTaskRegistrar.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainMeshBuilder.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainMeshUpload.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainTaskRegistrar.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveMeshBuilder.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveMeshUpload.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveTaskRegistrar.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Physic\PhysicsSimulationOverlapAnalysis.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Editor\UI\PhysicsSimulationOverlapUI.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\RenderSystem\RenderWorld\RenderWorld.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\RenderSystem\RenderPass\PostEffect\CameraPostEffectRuntimeStorage.h" />
    <ClInclude Remove="Source\GameApplication\Engine\Scene\System\Render\Animation\ModelRendererGpuRuntimeStorage.h" />

    <ClInclude Include="Source\GameApplication\Service\Graphics\D3D11ConstantBufferUpload.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Service\Graphics\D3D11ConstantBufferUpload.h')">
      <Link>Header Files\Service\Graphics\D3D11ConstantBufferUpload.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Animation\RenderSystemAnimationTaskRegistrar.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Animation\RenderSystemAnimationTaskRegistrar.h')">
      <Link>Header Files\Engine\Scene\System\Render\Animation\RenderSystemAnimationTaskRegistrar.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainMeshBuilder.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainMeshBuilder.h')">
      <Link>Header Files\Engine\Scene\System\Render\Terrain\TerrainMeshBuilder.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainMeshUpload.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainMeshUpload.h')">
      <Link>Header Files\Engine\Scene\System\Render\Terrain\TerrainMeshUpload.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainTaskRegistrar.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Terrain\TerrainTaskRegistrar.h')">
      <Link>Header Files\Engine\Scene\System\Render\Terrain\TerrainTaskRegistrar.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveMeshBuilder.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveMeshBuilder.h')">
      <Link>Header Files\Engine\Scene\System\Render\Terrain\WaveMeshBuilder.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveMeshUpload.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveMeshUpload.h')">
      <Link>Header Files\Engine\Scene\System\Render\Terrain\WaveMeshUpload.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveTaskRegistrar.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Terrain\WaveTaskRegistrar.h')">
      <Link>Header Files\Engine\Scene\System\Render\Terrain\WaveTaskRegistrar.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Physic\PhysicsSimulationOverlapAnalysis.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Physic\PhysicsSimulationOverlapAnalysis.h')">
      <Link>Header Files\Engine\Scene\System\Physic\PhysicsSimulationOverlapAnalysis.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Editor\UI\PhysicsSimulationOverlapUI.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Editor\UI\PhysicsSimulationOverlapUI.h')">
      <Link>Header Files\Engine\Editor\UI\PhysicsSimulationOverlapUI.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\RenderSystem\RenderWorld\RenderWorld.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\RenderSystem\RenderWorld\RenderWorld.h')">
      <Link>Header Files\Engine\Scene\System\Render\RenderSystem\RenderWorld\RenderWorld.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\RenderSystem\RenderPass\PostEffect\CameraPostEffectRuntimeStorage.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\RenderSystem\RenderPass\PostEffect\CameraPostEffectRuntimeStorage.h')">
      <Link>Header Files\Engine\Scene\System\Render\RenderSystem\RenderPass\PostEffect\CameraPostEffectRuntimeStorage.h</Link>
    </ClInclude>

    <ClInclude Include="Source\GameApplication\Engine\Scene\System\Render\Animation\ModelRendererGpuRuntimeStorage.h"
               Condition="Exists('$(MSBuildThisFileDirectory)Source\GameApplication\Engine\Scene\System\Render\Animation\ModelRendererGpuRuntimeStorage.h')">
      <Link>Header Files\Engine\Scene\System\Render\Animation\ModelRendererGpuRuntimeStorage.h</Link>
    </ClInclude>
  </ItemGroup>

  <!-- Static Batch専用ShaderはGameEngine x64だけでCSOへ変換する。 -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GameEngine' and '$(Platform)' == 'x64'">
    <FxCompile Include="Source\Shader\StaticBatchVS.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <ObjectFileOutput>Asset\Shader\StaticBatchVS.cso</ObjectFileOutput>
    </FxCompile>
    <FxCompile Include="Source\Shader\StaticBatchGBufferPS.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <ObjectFileOutput>Asset\Shader\StaticBatchGBufferPS.cso</ObjectFileOutput>
    </FxCompile>
  </ItemGroup>
</Project>